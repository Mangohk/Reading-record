# --- Google Spreadsheet (MVP database) ---
# Locked target spreadsheet ID (safe to commit in docs; set here for the app).
# Do NOT put service-account private keys in this file.
SPREADSHEET_ID=1uRgIHMA8KIjRad6LkJbghXHXKMTcsdbkHdUQdDIvJHs

# Which DAL adapter to use. MVP: sheets. Later: firebase.
DATA_STORE=sheets

# --- Google service account (server-side Sheets API) ---
# Share the spreadsheet with the service account email (Editor).
# Option A: path to JSON key file (recommended locally)
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/service-account.json
# Also accepted (Google default):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Option B: inline JSON string (useful on some hosts; keep secret!)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# --- Google OAuth (user login — wire-up in a later step) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of this app, e.g. http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Random secret for session encryption (generate locally; never commit real value)
NEXTAUTH_SECRET=

# Optional: Auth.js / NextAuth Google provider aliases
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_SECRET=
