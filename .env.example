# --- Google Spreadsheet (MVP database) ---
# Locked target spreadsheet ID (safe to commit in docs; set here for the app).
# Do NOT put service-account private keys in this file.
SPREADSHEET_ID=1uRgIHMA8KIjRad6LkJbghXHXKMTcsdbkHdUQdDIvJHs

# Which DAL adapter to use. MVP: sheets. Later: firebase.
DATA_STORE=sheets

# --- Google service account (server-side Sheets API) ---
# Create a GCP service account, enable Sheets API, download a JSON key,
# and share the spreadsheet with the SA email as Editor.
#
# Option A — email + private key (common on hosts / Cursor secrets):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=reading-record-sa@YOUR_PROJECT.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Option B — path to JSON key file (recommended locally):
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/service-account.json
# Also accepted (Google default env name):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
#
# Option C — inline JSON string (keep secret!):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}
#
# Option D — base64-encoded JSON (useful for some secret stores):
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# --- Google OAuth (user login via Auth.js / NextAuth) ---
# 1. Google Cloud Console → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Application type: Web application)
# 3. Authorized JavaScript origins: http://localhost:3000
# 4. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
# 5. Copy Client ID / Client Secret below (never commit real values)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth.js also accepts:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Public origin of this app
NEXTAUTH_URL=http://localhost:3000
# Auth.js v5 preferred alias for the same value:
# AUTH_URL=http://localhost:3000

# Random secret for session encryption — generate locally, e.g.:
#   openssl rand -base64 32
# Never commit the real value.
NEXTAUTH_SECRET=
# AUTH_SECRET=
